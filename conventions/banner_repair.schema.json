{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://artpipe.local/conventions/banner_repair.schema.json",
  "title": "Banner repair record (banners/repair.py)",
  "description": "repair.json next to a banner rendered with --repair: the request, the policy used, every render attempt with what failed, what was changed and why, and the final decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "request", "policy", "decision", "reason", "exit_code", "attempts", "summary", "report"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool": {"const": "artpipe.banners.repair"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kit", "template", "placement", "locale"],
      "properties": {
        "kit": {"type": "string"}, "template": {"type": "string"},
        "placement": {"type": "string"}, "locale": {"type": "string"}
      }
    },
    "policy": {
      "type": "object",
      "required": ["max_renders", "max_measure_passes", "fit_margin", "default", "actions"],
      "properties": {
        "max_renders": {"type": "integer", "minimum": 1},
        "max_measure_passes": {"type": "integer", "minimum": 1},
        "fit_margin": {"type": "number"},
        "default": {"type": "string"},
        "actions": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "decision": {"enum": ["accept", "stop"]},
    "reason": {"type": "string"},
    "exit_code": {"enum": [0, 1, 2]},
    "report": {"type": "string", "description": "The banner report, relative to this record's folder.", "pattern": "^[^/\\\\:]+$"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["render", "overrides", "failed", "warnings", "decision", "reason", "measure_passes", "changes", "mp4_sha256"],
        "properties": {
          "render": {"type": "integer", "minimum": 1},
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "required": ["font_scale", "colours"],
            "properties": {
              "font_scale": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
              "colours": {"type": "object", "additionalProperties": {"type": "string"}}
            }
          },
          "failed": {"type": "array", "items": {"type": "string"}},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "decision": {"enum": ["accept", "stop", "repair"]},
          "reason": {"type": "string"},
          "measure_passes": {"type": "integer", "minimum": 0},
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check", "action", "note"],
              "properties": {"check": {"type": "string"}, "action": {"type": "string"}, "note": {"type": "string"}}
            }
          },
          "mp4_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renders", "measure_passes"],
      "properties": {"renders": {"type": "integer"}, "measure_passes": {"type": "integer"}}
    }
  }
}
