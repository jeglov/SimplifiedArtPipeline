  "generated_by": "artpipe conventions --dump",
  "lock_version": 1,
  "naming": {
    "group_node": {
      "description": "Optional single root group in the Maya scene. Must equal the file name without extension.",
      "examples": [
        "SM_Crate",
        "SM_Crate_A",
        "SK_Runner_01"
      ],
      "invalid_examples": [
        "group1",
        "SM_Crate_LOD0",
        "SM_Crate_a"
      ],
      "pattern": "^(SM|SK)_[A-Z][A-Za-z0-9]{1,31}(_([A-Z]|[0-9]{2}))?$"
    },
    "material": {
      "description": "Material name. Shared atlas materials across many assets are encouraged on mobile (fewer draw calls, better batching).",
      "examples": [
        "M_Crate",
        "M_PropsAtlas",
        "M_Runner_01"
      ],
      "invalid_examples": [
        "lambert1",
        "MAT_Crate",
        "M_crate",
        "M_Crate_Wood"
      ],
      "pattern": "^M_[A-Z][A-Za-z0-9]{1,31}(_([A-Z]|[0-9]{2}))?$"
    },
    "mesh_file": {
      "description": "Exported model file. SM_ = static mesh, SK_ = skinned mesh. Optional variant: one capital letter or two digits.",
      "examples": [
        "SM_Crate.fbx",
        "SM_Crate_A.fbx",
        "SK_Runner_01.fbx"
      ],
      "invalid_examples": [
        "sm_crate.fbx",
        "SM_crate.fbx",
        "SM_Crate_A_LOD0.fbx",
        "SM_Wooden_Crate.fbx",
        "SM_Crate.FBX",
        "SM_Crate.obj"
      ],
      "pattern": "^(SM|SK)_[A-Z][A-Za-z0-9]{1,31}(_([A-Z]|[0-9]{2}))?\\.fbx$"
    },
    "mesh_node": {
      "description": "Mesh transform. _LOD<n> (0-3) is required when the asset has more than one LOD and omitted otherwise. Unity's model importer builds a LODGroup automatically from _LOD0.._LODn suffixes.",
      "examples": [
        "SM_Crate",
        "SM_Crate_A_LOD0",
        "SM_Crate_A_LOD2",
        "SK_Runner_01_LOD1"
      ],
      "invalid_examples": [
        "pCube1",
        "SM_Crate_LOD4",
        "SM_Crate_lod0",
        "SM_Crate__A",
        "SM_Crate_ABC",
        "SM_Crate_A_LOD0 "
      ],
      "pattern": "^(SM|SK)_[A-Z][A-Za-z0-9]{1,31}(_([A-Z]|[0-9]{2}))?(_LOD[0-3])?$"
    },
    "texture_file": {
      "description": "Texture file. Suffix = map type, defined in texture_rules.yaml (D base color, N normal, MS metallic/smoothness, AO occlusion, E emission).",
      "examples": [
        "T_Crate_D.png",
        "T_Crate_A_N.png",
        "T_PropsAtlas_MS.tga"
      ],
      "invalid_examples": [
        "T_Crate.png",
        "T_Crate_Diffuse.png",
        "T_Crate_D.jpg",
        "T_Crate_D.psd",
        "Crate_D.png",
        "T_Crate_d.png"
      ],
      "pattern": "^T_[A-Z][A-Za-z0-9]{1,31}(_([A-Z]|[0-9]{2}))?_(D|N|MS|AO|E)\\.(png|tga)$"
    }
  },
