# Normalise text to LF so diffs of reports/conventions are identical on every OS.
* text=auto eol=lf
# Windows batch files misparse labels/goto with LF endings: keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
# Maya ASCII is text (diffable), but must not be re-encoded.
*.ma  text eol=lf
# Binary DCC / image formats: never touch line endings.
*.mb  binary
*.fbx binary
*.png binary
*.tga binary
*.psd binary
*.exr binary
# Unity. Text YAML (Force Text serialization) stays LF so meta/scene diffs
# are identical on every OS. A .meta file holds the asset's GUID: losing or
# rewriting one breaks every reference to that asset.
*.meta    text eol=lf
*.unity   text eol=lf
*.prefab  text eol=lf
*.mat     text eol=lf
*.asmdef  text eol=lf
*.asmref  text eol=lf
*.cs      text eol=lf
*.uss     text eol=lf
*.uxml    text eol=lf
# .asset is NOT forced to text: a few asset types (lighting data, terrain)
# stay binary even under Force Text, and "text" would corrupt them. The
# global "* text=auto" above detects them by content.
# Unity-side binaries
*.jpg  binary
*.jpeg binary
*.tif  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.ogg  binary
*.dll  binary
